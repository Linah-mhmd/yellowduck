# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=false
PORT=5001

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=graduation

# CORS (comma-separated origins — in production use your Render URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production example (Render):
# CORS_ORIGINS=https://yellowduck-xxxx.onrender.com
# FRONTEND_URL=https://yellowduck-xxxx.onrender.com
# SESSION_COOKIE_SECURE=true
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/graduation?retryWrites=true&w=majority

# Session cookies (set true in HTTPS production)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Uploads
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Email verification (set true to block actions until verified)
REQUIRE_EMAIL_VERIFICATION=false

# SMTP (optional — logs to console when disabled)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=noreply@yellowduck.com
